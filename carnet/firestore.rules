rules_version = '2';
// Dogs Life — security rules
// - each family only sees its own data
// - you enter a family by creating it (owner) or with a valid, unexpired join code made by a member
// - your role comes from the code and cannot be changed by yourself
// - "garde" (pet sitter) can tick, log and write messages, not change the routine, health or settings
// - each phone's notification address is private to its owner
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function me() { return request.auth.uid; }
    function famPath(fid) { return /databases/$(database)/documents/families/$(fid); }
    function accPath(fid) { return /databases/$(database)/documents/families/$(fid)/access/$(request.auth.uid); }
    function isMember(fid) { return signedIn() && exists(accPath(fid)); }
    function isOwner(fid) { return signedIn() && get(famPath(fid)).data.owner == me(); }
    function isSitter(fid) { return get(accPath(fid)).data.get('role', 'famille') == 'garde' && !isOwner(fid); }
    function canEdit(fid) { return isMember(fid) && !isSitter(fid); }
    function fields(n) { return request.resource.data.size() <= n; }
    function validRole(r) { return r in ['famille', 'garde']; }
    function codeDoc(h) { return get(/databases/$(database)/documents/codes/$(h)).data; }

    // which family an account belongs to: only that account
    match /users/{uid} {
      allow read, delete: if signedIn() && me() == uid;
      allow create, update: if signedIn() && me() == uid
        && request.resource.data.keys().hasOnly(['family'])
        && request.resource.data.family is string && request.resource.data.family.size() <= 64;
    }

    // join codes, stored under their hash: you can only find one if you know the code
    match /codes/{h} {
      allow get: if signedIn();
      allow list, update: if false;
      allow create: if h.size() == 64
        && request.resource.data.keys().hasOnly(['family', 'role', 'exp', 'invite', 'byName'])
        && canEdit(request.resource.data.family)
        && validRole(request.resource.data.role)
        && request.resource.data.exp is int
        && request.resource.data.exp > request.time.toMillis()
        && request.resource.data.exp <= request.time.toMillis() + 8 * 86400000
        && request.resource.data.get('byName', '') is string && request.resource.data.get('byName', '').size() <= 60;
      allow delete: if isMember(resource.data.family);
    }

    match /families/{fid} {
      allow get: if isMember(fid) || (signedIn() && resource.data.owner == me());
      allow list: if false;
      allow create: if signedIn() && fid.size() <= 64
        && request.resource.data.keys().hasOnly(['owner', 'at'])
        && request.resource.data.owner == me();
      // nobody can take the family over; the owner can hand it to someone already in it (when leaving)
      allow update: if isOwner(fid) && fields(20) && request.resource.data.keys().hasOnly(['owner', 'at'])
        && (request.resource.data.owner == resource.data.owner
            || exists(/databases/$(database)/documents/families/$(fid)/access/$(request.resource.data.owner)));
      allow delete: if false;

      // who may enter: the owner, or someone holding a valid code (with exactly the role written in it)
      match /access/{uid} {
        allow read: if isMember(fid);
        allow create: if signedIn() && me() == uid && (
          (request.resource.data.keys().hasOnly(['at', 'owner'])
            && request.resource.data.owner == true
            && get(famPath(fid)).data.owner == uid)
          || (request.resource.data.keys().hasOnly(['at', 'code', 'role'])
            && request.resource.data.code is string && request.resource.data.code.size() == 64
            && exists(/databases/$(database)/documents/codes/$(request.resource.data.code))
            && codeDoc(request.resource.data.code).family == fid
            && codeDoc(request.resource.data.code).exp > request.time.toMillis()
            && request.resource.data.role == codeDoc(request.resource.data.code).role)
        );
        allow update: if false;
        // leave yourself, or be removed by a family member; the owner can never be removed
        allow delete: if isMember(fid) && (me() == uid || canEdit(fid)) && get(famPath(fid)).data.owner != uid;
      }

      // each phone's notification address: only its owner reads or changes it (the server uses its own key)
      match /pushTokens/{tid} {
        allow read, delete: if isMember(fid) && resource.data.uid == me();
        allow create: if isMember(fid) && request.resource.data.uid == me() && fields(12);
        allow update: if isMember(fid) && resource.data.uid == me() && request.resource.data.uid == me() && fields(12);
      }

      // notification centre: each person sees, marks as read and deletes only their own notifications (only the server writes them)
      match /inbox/{nid} {
        allow read, delete: if isMember(fid) && resource.data.to == me();
        allow update: if isMember(fid) && resource.data.to == me()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'readAt']);
        allow create: if false;
      }

      // iPhone widget keys: each person creates and removes only their own (only a hash is stored; the server reads it)
      match /widgets/{wid} {
        allow read, delete: if isMember(fid) && resource.data.uid == me();
        allow create: if isMember(fid) && wid.size() == 64 && request.resource.data.uid == me() && fields(6);
        allow update: if false;
      }

      // everything in the carnet (dog, routine, health, ticks, messages…): members only
      match /{col}/{docId} {
        allow read: if isMember(fid) && !(col in ['access', 'pushTokens', 'inbox', 'widgets']);

        allow create: if isMember(fid) && !(col in ['access', 'pushTokens', 'inbox', 'widgets']) && fields(80)
          && (canEdit(fid) || sitterCreate(col, docId));
        allow update: if isMember(fid) && !(col in ['access', 'pushTokens', 'inbox', 'widgets']) && fields(80)
          && (canEdit(fid) || sitterUpdate(col, docId))
          // a person's role and account link never change through the app
          && (col != 'members' || (request.resource.data.get('uid', '') == resource.data.get('uid', '')
                                   || resource.data.get('uid', '') == '')
                               && (canEdit(fid) || request.resource.data.get('role', '') == resource.data.get('role', '')));
        allow delete: if isMember(fid) && !(col in ['access', 'pushTokens', 'inbox', 'widgets'])
          && (canEdit(fid) || sitterDelete(col, docId));
      }

      // what a pet sitter may do
      function sitterCreate(col, docId) {
        return col in ['days', 'ticks', 'logs', 'train']
          || (col == 'notes' && request.resource.data.get('uid', me()) == me())
          || (col == 'config' && docId in ['food', 'weather'])
          || (col == 'members' && request.resource.data.get('uid', '') == me());
      }
      function sitterUpdate(col, docId) {
        return col in ['days', 'ticks', 'logs', 'train']
          || (col == 'notes' && resource.data.get('uid', '') == me())
          || (col == 'config' && docId in ['food', 'weather'])
          || (col == 'members' && resource.data.get('uid', '') == me());
      }
      function sitterDelete(col, docId) {
        return col in ['ticks', 'logs', 'invites']
          || (col == 'notes' && resource.data.get('uid', '') == me())
          || (col == 'members' && resource.data.get('uid', '') == me());
      }
    }
  }
}
